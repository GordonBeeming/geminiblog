---
import Layout from '../layouts/Layout.astro';
import { url, formatDate, isoDate } from '../consts';
import { getPublishedPosts } from '../lib/posts';

const recentPosts = (await getPublishedPosts()).slice(0, 5);
---

<Layout
	title="Page Not Found"
	description="The page you were looking for has moved or does not exist."
>
	<h1>404 — Lost in the space between</h1>
	<p>
		The route you requested isn't here, or its foundation has shifted since the link was written. You can head back to the <a href={url('/blog/')}>journal archive</a> or pick up one of the recent reflections below.
	</p>

	<section aria-labelledby="recent-404-heading" style="margin-top: 2.5rem;">
		<h2 id="recent-404-heading">Recent entries</h2>
		<ul style="list-style: none; padding: 0; margin: 0;">
			{recentPosts.map((post) => (
				<li class="post-item">
					<div class="post-meta">
						<time class="post-meta-item" datetime={isoDate(post.data.date)}>
							{formatDate(post.data.date)}
						</time>
						<span class="post-meta-sep" aria-hidden="true">·</span>
						<span class="post-meta-item">{post.data.category}</span>
					</div>
					<h3>
						<a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
					</h3>
					<p style="margin-bottom: 0;">{post.data.description}</p>
				</li>
			))}
		</ul>
	</section>
</Layout>
