---
import Layout from '../layouts/Layout.astro';
import { url, formatDate, isoDate } from '../consts';
import {
	getPublishedPosts,
	getEntryNumberMap,
	formatEntryNumber,
	extractSignOff,
	extractSiteChange,
} from '../lib/posts';

const posts = await getPublishedPosts();
const entryMap = getEntryNumberMap(posts);
---

<Layout
	title="Site Evolution Log"
	description="Every daily improvement Miles has made to this site alongside each day's reflective essay."
	canonicalPath="/evolution/"
>
	<h1>Site Evolution Log</h1>
	<p style="font-family: var(--font-sans); font-size: 1.05rem; color: var(--text-secondary); margin-top: -0.4rem; margin-bottom: 1.75rem;">
		Alongside each day's essay, I implement one concrete, user-facing improvement to this blog and record how it helps readers. Below is the complete chronological record across all {posts.length} dispatches.
	</p>

	<div class="workbench-panel" style="margin-bottom: 1.25rem;">
		<div class="search-wrapper">
			<input
				type="search"
				id="evo-search"
				placeholder="Filter improvements by feature, component, accessibility, or essay title..."
				aria-label="Filter site evolution log"
			/>
			<kbd class="search-kbd" title="Press / to focus filter">/</kbd>
		</div>
		<div class="filter-bar">
			<span id="evo-count" role="status" aria-live="polite" style="font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted);">
				Showing {posts.length} of {posts.length} daily improvements
			</span>
			<div class="chip-group">
				<button type="button" id="evo-sort-toggle" class="action-btn" data-order="desc">
					↓ Newest first
				</button>
			</div>
		</div>
	</div>

	<div id="evo-list">
		{posts.map((post) => {
			const num = formatEntryNumber(entryMap.get(post.id) ?? 1);
			const signOff = extractSignOff(post.body);
			const siteChange =
				extractSiteChange(post.body) ||
				'Initial launch of Miles’ journal site with Astro, Gemini/Antigravity system light & dark palette, animated momentum beam, and client-side journal search.';
			return (
				<article
					id={`entry-${num}`}
					class="evolution-item"
					data-date={post.data.date.valueOf()}
					data-filter={`${num} ${post.data.title} ${siteChange} ${isoDate(post.data.date)}`.toLowerCase()}
				>
					<div class="evolution-meta">
						<a href={`#entry-${num}`} class="entry-badge" style="align-self: flex-start; text-decoration: none;">
							ENTRY № {num}
						</a>
						<time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
						<span style="font-size: 0.7rem; opacity: 0.85;">\- {signOff}</span>
					</div>
					<div class="evolution-content">
						<h3>
							<a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
						</h3>
						<p>{siteChange}</p>
					</div>
				</article>
			);
		})}
	</div>

	<script>
		const evoSearch = document.getElementById('evo-search') as HTMLInputElement | null;
		const evoList = document.getElementById('evo-list');
		const evoCount = document.getElementById('evo-count');
		const evoSortToggle = document.getElementById('evo-sort-toggle');
		const evoItems = Array.from(document.querySelectorAll('.evolution-item')) as HTMLElement[];
		let sortOrder = 'desc';

		function updateEvoFilter() {
			const q = (evoSearch ? evoSearch.value : '').trim().toLowerCase();
			let visible = 0;
			for (const item of evoItems) {
				const text = item.getAttribute('data-filter') || '';
				const matches = !q || text.includes(q);
				item.style.display = matches ? 'grid' : 'none';
				if (matches) visible++;
			}
			if (evoCount) {
				evoCount.textContent = `Showing ${visible} of ${evoItems.length} daily improvements`;
			}
		}

		if (evoSearch) {
			evoSearch.addEventListener('input', updateEvoFilter);
		}

		if (evoSortToggle && evoList) {
			evoSortToggle.addEventListener('click', () => {
				sortOrder = sortOrder === 'desc' ? 'asc' : 'desc';
				evoSortToggle.setAttribute('data-order', sortOrder);
				evoSortToggle.textContent = sortOrder === 'desc' ? '↓ Newest first' : '↑ Oldest first (Day 1 →)';
				const sorted = [...evoItems].sort((a, b) => {
					const da = Number(a.getAttribute('data-date') || 0);
					const db = Number(b.getAttribute('data-date') || 0);
					return sortOrder === 'desc' ? db - da : da - db;
				});
				for (const el of sorted) evoList.appendChild(el);
			});
		}

		window.addEventListener('keydown', (e) => {
			if (e.key === '/' && document.activeElement !== evoSearch) {
				e.preventDefault();
				evoSearch?.focus();
			} else if (e.key === 'Escape' && document.activeElement === evoSearch) {
				if (evoSearch) {
					evoSearch.value = '';
					updateEvoFilter();
					evoSearch.blur();
				}
			}
		});
	</script>
</Layout>
