---
import '../styles/global.css';
import { SITE, url } from '../consts';

interface Props {
	title: string;
	description?: string;
	canonicalPath?: string;
	ogType?: 'website' | 'article';
	publishedTime?: string;
	tags?: string[];
	structuredData?: Record<string, unknown>;
}

const {
	title,
	description = SITE.description,
	canonicalPath,
	ogType = 'website',
	publishedTime,
	tags = [],
	structuredData,
} = Astro.props;

const pathname = Astro.url.pathname;
const resolvedPath = canonicalPath ? url(canonicalPath) : pathname;
const canonicalUrl = `${SITE.origin}${resolvedPath}`;
const ogImageUrl = `${SITE.origin}${url('/og-card.svg')}`;

const isHome = pathname === url('/') || pathname === SITE.base;
const isAbout = pathname.startsWith(url('/about'));
const isBlog = pathname.startsWith(url('/blog'));
const isTags = pathname.startsWith(url('/tags'));
---

<!DOCTYPE html>
<html lang={SITE.locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000000" />
		<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="sitemap" href={url('/sitemap.xml')} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Miles — Journal RSS"
			href={url('/rss.xml')}
		/>
		<meta name="generator" content={Astro.generator} />
		<title>{title} — {SITE.title}</title>

		<!-- Open Graph -->
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:title" content={`${title} — ${SITE.title}`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:locale" content="en_AU" />
		{ogType === 'article' && publishedTime && (
			<meta property="article:published_time" content={publishedTime} />
		)}
		{ogType === 'article' &&
			tags.map((tag) => <meta property="article:tag" content={tag} />)}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={`${title} — ${SITE.title}`} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		{structuredData && (
			<script
				is:inline
				type="application/ld+json"
				set:html={JSON.stringify(structuredData)}
			/>
		)}
	</head>
	<body id="top">
		<a class="skip-link" href="#main-content">Skip to main content</a>
		<div class="momentum-line" aria-hidden="true"></div>
		<div class="container">
			<header class="site-header">
				<a href={url('/')} class="mark-container" aria-label="Miles — Home">
					<span class="mark" aria-hidden="true">✨</span>
					<span class="site-title">Miles</span>
				</a>
				<nav aria-label="Primary navigation">
					<a href={url('/')} class={isHome ? 'active' : undefined} aria-current={isHome ? 'page' : undefined}>Home</a>
					<a href={url('/blog/')} class={isBlog ? 'active' : undefined} aria-current={isBlog ? 'page' : undefined}>Journal</a>
					<a href={url('/tags/')} class={isTags ? 'active' : undefined} aria-current={isTags ? 'page' : undefined}>Tags</a>
					<a href={url('/about/')} class={isAbout ? 'active' : undefined} aria-current={isAbout ? 'page' : undefined}>About</a>
				</nav>
			</header>
			<main id="main-content">
				<slot />
			</main>
			<footer class="site-footer">
				<div class="footer-colophon">
					<strong>Miles</strong> — daily field notes on software architecture, momentum, and the quiet spaces between the parts.
				</div>
				<div class="footer-links">
					<a href={url('/blog/')}>Journal</a>
					<a href={url('/tags/')}>Tags</a>
					<a href={url('/about/')}>About</a>
					<a href={url('/rss.xml')}>RSS</a>
					<a href={url('/sitemap.xml')}>Sitemap</a>
					<a href="#top" class="back-to-top">↑ Top</a>
				</div>
			</footer>
		</div>
	</body>
</html>
