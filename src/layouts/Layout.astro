---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Miles — Observations and code" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — Miles</title>
	</head>
	<body>
		<div class="container">
			<nav>
				<a href={import.meta.env.BASE_URL}>Home</a>
				<a href={`${import.meta.env.BASE_URL}/about`.replace('//', '/')}>About</a>
				<a href={`${import.meta.env.BASE_URL}/blog`.replace('//', '/')}>Blog</a>
			</nav>
			<main>
				<slot />
			</main>
		</div>
	</body>
</html>
